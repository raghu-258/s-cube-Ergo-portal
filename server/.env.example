# Copy to server/.env for local development. Every setting is optional locally:
# without them the server uses an in-memory database, saves videos to server/.data,
# and prints emails (including sign-in codes) to the console.
# On Cloud Run, set these as environment variables / secrets instead (see README.md).

# ---- sign-in ----
ALLOWED_DOMAIN=scube-ergo.com
# Email code sign-in: people enter their work email and get a 6-digit code by email.
# On by default; needs the SMTP settings below in production. Set to false to turn it off.
# OTP_LOGIN=true
# Optional "Continue with Google" button: OAuth client ID from Google Cloud
# (Google Auth Platform → Clients → Web application)
GOOGLE_CLIENT_ID=
# Random string of 32+ characters. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# These people are admins when they sign in. Admins can promote others in People & progress.
ADMIN_EMAILS=raghu@scube-ergo.com

# ---- data ----
# PostgreSQL connection. Leave empty (or "memory") for a throwaway in-memory database.
#   Neon / other hosts: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#   Cloud SQL on Cloud Run: postgresql://USER:PASSWORD@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=
# Google Cloud Storage bucket for course videos. Leave empty locally.
GCS_BUCKET=
# Service-account key for the bucket: the whole JSON key file's contents on one line.
# Needed on Render (not on Cloud Run, which uses its own identity).
GCS_CREDENTIALS=

# ---- birthday & anniversary emails ----
TIMEZONE=Asia/Kolkata
ALL_EMPLOYEES_EMAIL=team@scube-ergo.com
# While set, the daily job emails only this address (marked [TEST]). Remove it to go live.
TEST_RECIPIENT=raghu@scube-ergo.com
# Addresses allowed to receive "Send test email" previews
TEST_EMAIL_RECIPIENTS=raghu@scube-ergo.com,sneha@scube-ergo.com
# Cloud Scheduler sends this in the X-Cron-Secret header. Random string.
CRON_SECRET=
# Sending email. Use ONE of these two:
# (a) Gmail API over HTTPS. Required on Render's free plan, which blocks SMTP.
#     OAuth client (type "Desktop app") from Google Cloud; then run `npm run gmail-auth -w server`
#     once, which fills in GMAIL_REFRESH_TOKEN. Takes priority over SMTP when all three are set.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# (b) Gmail / Google Workspace SMTP. SMTP_PASS is a Google app password for SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Scube Celebrations <raghu@scube-ergo.com>
# Linked at the bottom of each email
PORTAL_URL=
